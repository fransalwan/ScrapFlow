# ===== App =====
APP_ENV=development            # development | production
GIN_MODE=debug
PORT=8080
CORS_ORIGIN=http://localhost:5173

# ===== Database =====
DB_HOST=localhost
DB_PORT=5433                   # port host dari docker-compose.yml
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scrapFlow_db
DB_SSLMODE=disable

# ===== Auth =====
JWT_SECRET=ganti-dengan-string-acak-panjang   # WAJIB di production
JWT_EXPIRATION_HOURS=24

# ===== AI Agent (opsional) =====
AGENT_ENABLED=false
AGENT_PROVIDER=gemini          # gemini | openai (OpenAI-compatible, eksperimental di ADK)
AGENT_MODEL=                   # wajib diisi saat enabled; pilih model terbaru yang mendukung function calling
AGENT_API_KEY=
AGENT_BASE_URL=                # opsional, hanya untuk provider openai
AGENT_ALLOWED_ROLES=admin      # dipisah koma
AGENT_RATE_LIMIT_PER_HOUR=30
AGENT_TIMEOUT_SECONDS=60
AGENT_TIMEZONE=Asia/Jakarta
